types WarhammerSpellbookTypes {
 type we_spellbook_panel = widget {
  name = "we_spellbook_panel"
  parentanchor = top|right
  widgetanchor = top|right
  position = { -62 82 }
  size = { 624 570 }
  layer = top
  visible = "[And(And(GetPlayer.IsValid, GetScriptedGui('we_book_show').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End)), And(Not(IsRightWindowOpen), Not(IsPauseMenuShown)))]"
  filter_mouse = all
  background = { using = Background_Area_Border_Solid }
  text_single = { parentanchor = top|left widgetanchor = top|left position = { 16 12 } text = "we_book_title" fontsize = 21 }
  button_standard = { parentanchor = top|left widgetanchor = top|left position = { 578 11 } size = { 32 25 } text = "we_book_close" onclick = "[GetScriptedGui('we_book_open').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]" }
  text_single = { parentanchor = top|left widgetanchor = top|left position = { 16 42 } text = "we_mana_compact" fontsize = 13 }
  text_single = { parentanchor = top|left widgetanchor = top|left position = { 181 42 } text = "we_book_regeneration" fontsize = 12 }
  widget = {
 name = "we_spellbook_favorites_strip"
 parentanchor = top|left widgetanchor = top|left
 position = { 14 68 }
 size = { 596 41 }
 background = { using = Background_Area_Dark alpha = 0.8 }
 
 text_single = { parentanchor = top|left widgetanchor = top|left position = { 8 12 } text = "we_book_favorites" fontsize = 13 }
 widget = {
  parentanchor = top|left widgetanchor = top|left
  position = { 103 5 }
  size = { 360 32 }
  scissor = yes
  hbox = { parentanchor = top|left widgetanchor = top|left spacing = 5 button_standard = {
 size = { 37 30 }
 visible = "[GetScriptedGui('we_book_pin_fire_0').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
 enabled = "[GetScriptedGui('we_book_cast_fire_0').IsValid(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
 onclick = "[GetScriptedGui('we_book_cast_fire_0').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
 tooltip = "we_book_spell_fire_0_tt"
 icon = { parentanchor = center widgetanchor = center size = { 23 23 } texture = "gfx/interface/icons/modifiers/we_magic_fire.dds" }
}
